// Cloudflare deploy target for the built site (see .github/workflows/jekyll.yml).
// The site is served by a static Worker named "italai": the finished _site/
// folder is uploaded as its static assets. No JS entry — assets only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "italai",
  "assets": {
    "directory": "./_site"
  }
}
